# LLM gateway: all three models are served by one POST endpoint (D-041)
LLM_BASE_URL=

# API key for the LLM gateway (leave empty if the gateway needs none)
LLM_API_KEY=

# Model IDs per tier (docs/AGENTS.md section 2, D-041)
# strong = GPT-5.6 Luna, code = DeepSeek V4 Pro, fast = GPT-5 Mini
LLM_MODEL_STRONG=
LLM_MODEL_CODE=
LLM_MODEL_FAST=

# Performance Council on/off (true|false)
FEATURE_COUNCIL=

# Supermemory (Librarian retrieval, D-038)
SUPERMEMORY_API_KEY=

# LangSmith tracing (D-039)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=
LANGSMITH_PROJECT=

# Database connection string
DATABASE_URL=

# Secret key used by the backend app (sessions, signing, etc.)
APP_SECRET=

# Owner sign-in: scrypt hash from `python scripts/hash_password.py` (run in backend/)
OWNER_PASSWORD_HASH=

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=

# Webhook URL for n8n integration
N8N_WEBHOOK_URL=

# Shared secret for verifying n8n webhook signatures
N8N_SIGNING_SECRET=

# Publicly reachable base URL of this deployment
PUBLIC_BASE_URL=

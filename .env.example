# LLM provider to use (see ARCHITECTURE.md section 8)
LLM_PROVIDER=

# API key(s) for the LLM provider; may be suffixed per-provider (e.g. LLM_API_KEY_OPENAI)
LLM_API_KEY_=

# Strong/high-quality LLM model identifier
LLM_MODEL_STRONG=

# Fast/cheap LLM model identifier
LLM_MODEL_FAST=

# Database connection string
DATABASE_URL=

# Secret key used by the backend app (sessions, signing, etc.)
APP_SECRET=

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=

# Webhook URL for n8n integration
N8N_WEBHOOK_URL=

# Shared secret for verifying n8n webhook signatures
N8N_SIGNING_SECRET=

# Publicly reachable base URL of this deployment
PUBLIC_BASE_URL=
